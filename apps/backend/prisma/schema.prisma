generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OtpCode {
  id           String   @id @default(uuid())
  otp_code     String
  member_name  String
  member_email String
  is_used      Boolean  @default(false)
  is_expired   Boolean  @default(false)
  added_at     DateTime @default(now())
  archived_at  DateTime?

  @@map("otp_codes")
}
